    <!-- Intro -->
    <string name="intro_title">⚔️  A királyi rendelet  ⚔️</string>
    <string name="intro_subtitle">A Kvíz Lovag Tanács rendeletére</string>
    <string name="intro_line_1">Halljátok, halljátok, ó bátor lélek!</string>
    <string name="intro_line_2">A birodalom hatalmas. A települések számosak.</string>
    <string name="intro_line_3">A kérdések… meglepően nehezek.</string>
    <string name="intro_line_4">A küldetésed: lovagolj át a királyságon,</string>
    <string name="intro_line_5">látogass el minden városba és faluba, és</string>
    <string name="intro_line_6">válaszolj ördögien nehéz kérdésekre</string>
    <string name="intro_line_7">történelemből, tudományból, földrajzból,</string>
    <string name="intro_line_8">irodalomból, filmekből, művészetből és fizikából.</string>
    <string name="intro_line_9">Helyes válasz → meghódítod a földet.</string>
    <string name="intro_line_10">Rossz válasz → szégyent vallasz,</string>
    <string name="intro_line_11">és újra kell próbálkoznod. 💀</string>
    <string name="intro_line_12">A jó hír: a lovad sosem fárad el.</string>
    <string name="intro_line_13">A rossz hír: az agyad talán igen.</string>
    <string name="intro_line_14">Hódíts meg MINDEN települést, hogy</string>
    <string name="intro_line_15">a legendás Kvíz Lovaggá válj! ⚔️👑</string>
    <string name="intro_line_16">Sok szerencsét. Szükséged lesz rá.</string>
    <string name="intro_seal_caption">— A Tanács, Anno Domini MMXXVI —</string>
    <string name="intro_accept_button">Elfogadom a sorsom  ⚔️</string>
    <string name="intro_skip_button">Bevezető kihagyása</string>
    <string name="intro_tap_hint">(vagy koppints bárhova a kezdéshez)</string>

