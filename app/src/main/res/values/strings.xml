    <!-- Intro -->
    <string name="intro_title">⚔️  The Royal Decree  ⚔️</string>
    <string name="intro_subtitle">By Order of the Quiz Knight Council</string>
    <string name="intro_line_1">Hear ye, hear ye, O Brave Soul!</string>
    <string name="intro_line_2">The realm is vast. The settlements are many.</string>
    <string name="intro_line_3">The questions… are surprisingly hard.</string>
    <string name="intro_line_4">Your quest: ride across the kingdom,</string>
    <string name="intro_line_5">enter each city and village, and</string>
    <string name="intro_line_6">answer fiendishly difficult questions</string>
    <string name="intro_line_7">on History, Science, Geography,</string>
    <string name="intro_line_8">Literature, Films, Art &amp; Physics.</string>
    <string name="intro_line_9">Answer correctly → you conquer the land.</string>
    <string name="intro_line_10">Answer wrongly → you suffer shame</string>
    <string name="intro_line_11">and must try again. 💀</string>
    <string name="intro_line_12">The good news: your horse never tires.</string>
    <string name="intro_line_13">The bad news: your brain might.</string>
    <string name="intro_line_14">Conquer ALL settlements to become</string>
    <string name="intro_line_15">the legendary Quiz Knight! ⚔️👑</string>
    <string name="intro_line_16">Good luck. You\'ll need it.</string>
    <string name="intro_seal_caption">— The Council, Anno Domini MMXXVI —</string>
    <string name="intro_accept_button">I Accept My Fate  ⚔️</string>
    <string name="intro_skip_button">Skip Intro</string>
    <string name="intro_tap_hint">(or tap anywhere to begin)</string>

